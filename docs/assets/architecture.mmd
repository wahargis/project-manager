        KG["Knowledge graph engine<br/>traversal · contradiction detection"]
        ANALYSIS["Analysis<br/>confidence · contradiction scoring"]
        VALIDATE["Validation<br/>decision & finding rules"]
    end

    subgraph STORE["Persistence"]
        SQLITE["SQLite via rusqlite (bundled)<br/>schema migrations v1-v15"]
        DB[("pm.db<br/>default: ~/.local/share/pm/pm.db")]
    end

    AGENT -->|"JSON-RPC over stdio"| MCP
    CLI --> CMDS
    CMDS --> CORE
